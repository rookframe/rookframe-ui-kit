[gd_scene format=3]

[node name="SummaryPair" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Inset" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_top = 14
theme_override_constants/margin_bottom = 14

[node name="Row" type="HBoxContainer" parent="Inset"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Label" type="Label" parent="Inset/Row"]
layout_mode = 2
size_flags_vertical = 0
custom_minimum_size = Vector2(100, 0)
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.568627, 0.6, 0.603922, 1)

[node name="Value" type="Label" parent="Inset/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
horizontal_alignment = 2
autowrap_mode = 2

[node name="Rule" type="ColorRect" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(0, 1)
color = Color(0.133333, 0.196078, 0.215686, 1)
mouse_filter = 2
