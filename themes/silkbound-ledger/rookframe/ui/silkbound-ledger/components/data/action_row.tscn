[gd_scene format=3]

[ext_resource type="PackedScene" path="res://rookframe/ui/components/data/action_row.tscn" id="base"]
[ext_resource type="Theme" path="res://rookframe/ui/theme/silkbound_theme.tres" id="skin_theme"]

